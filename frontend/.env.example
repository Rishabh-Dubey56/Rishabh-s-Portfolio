# ============================================
# EmailJS Client Integration Credentials
# Sign up and configure at https://www.emailjs.com
# ============================================

# 1. EmailJS Service ID (Created under Email Services, e.g. Gmail integration)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# 2. EmailJS Template ID (Created under Email Templates)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# 3. EmailJS Public Key (Found under Account > API Keys > Public Key)
# NOTE: Only expose the Public Key. Never expose the Private Key in frontend applications!
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

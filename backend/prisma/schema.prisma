// ============================================
// Prisma Schema — Rishabh Dubey Portfolio
// ============================================
// Database: PostgreSQL
// NOTE: DATABASE_URL must be configured in backend/.env
// before running `npx prisma migrate dev`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Portfolio Content Models ──

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  thumbnail   String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("projects")
}

model Experience {
  id          String   @id @default(cuid())
  role        String
  company     String
  companyUrl  String?
  startDate   DateTime
  endDate     DateTime?
  description String
  type        String   @default("internship") // full-time | part-time | internship | freelance | contract
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("experiences")
}

model Achievement {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  category    String   @default("other") // award | certification | competition | publication | other
  url         String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("achievements")
}

// ── Contact / Messaging ──

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("messages")
}

// ── Authentication ──

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}
